Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep application source and configuration files out of the web root.
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor|tests|Feature|Unit|testing|framework|Controllers|Models|Services|Http|Auth|Providers)(/|$) - [F,L,NC]
    RewriteRule ^\.well-known/ - [L]
    RewriteRule (^|/)\. - [F,L]

    # Serve the Laravel public directory while keeping the application layout intact.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^(\.env|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|.*\.sql)$">
    Require all denied
</FilesMatch>